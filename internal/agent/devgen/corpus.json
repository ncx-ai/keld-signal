{
  "bash_templates": {
    "go": [
      "go test ./...",
      "go build ./...",
      "go vet ./...",
      "git status",
      "git diff --stat",
      "gofmt -l ."
    ],
    "python": [
      "pytest -q",
      "python3 -m pytest app/test_blocks.py",
      "ruff check .",
      "git status",
      "git diff --stat"
    ],
    "typescript": [
      "pnpm test",
      "pnpm build",
      "npx tsc --noEmit",
      "git status",
      "git diff --stat"
    ]
  },
  "branch_slugs": [
    "block-cutter",
    "retry-policy",
    "auth-flow",
    "queue-backpressure",
    "token-accounting",
    "workspace-resolver",
    "prompt-index",
    "telemetry-proxy",
    "schema-migration",
    "session-store",
    "settings-poll",
    "sidecar-client"
  ],
  "default_repositories": [
    {
      "language": "go",
      "remote": "github.com/ncx-ai/keld-signal",
      "ticket_prefix": "KELD",
      "workspace": "keld-signal"
    },
    {
      "language": "go",
      "remote": "github.com/ncx-ai/keld-atlas",
      "ticket_prefix": "ATLAS",
      "workspace": "keld-atlas"
    },
    {
      "language": "python",
      "remote": "github.com/ncx-ai/sdk-testbench",
      "ticket_prefix": "SDK",
      "workspace": "sdk-testbench"
    }
  ],
  "dev_conditions": [
    "the queue is full",
    "the branch has no remote",
    "tokens exceed the cap",
    "the store is behind",
    "a retry storms the sidecar",
    "the idle timer fires",
    "two sessions race",
    "the cache goes cold",
    "the config is missing a key",
    "the daemon restarts mid-job"
  ],
  "dev_objects": [
    "the ingest pipeline",
    "the block cutter",
    "the retry policy",
    "the session store",
    "the auth flow",
    "the settings poll",
    "the sidecar client",
    "the queue backpressure",
    "the token accounting",
    "the workspace resolver",
    "the prompt index",
    "the telemetry proxy",
    "the reconnection logic",
    "the schema migration",
    "the CLI flag parsing",
    "the readiness gate",
    "the spool drain"
  ],
  "dev_verbs": [
    "fix",
    "refactor",
    "add",
    "wire up",
    "investigate",
    "extend",
    "harden",
    "document",
    "debug",
    "optimize",
    "clean up",
    "migrate",
    "test",
    "review",
    "implement",
    "simplify",
    "stabilize"
  ],
  "grep_patterns": [
    "TODO",
    "FIXME",
    "func ",
    "class ",
    "import ",
    "def ",
    "export "
  ],
  "lang_files": {
    "go": [
      "internal/agent/blocks/blocks.go",
      "internal/agent/queue/queue.go",
      "internal/agent/publish/window.go",
      "internal/agent/daemon/daemon.go",
      "cmd/keld-agent/main.go",
      "go.mod",
      "README.md"
    ],
    "python": [
      "app/analysis/blocks.py",
      "app/analysis/store.py",
      "app/analysis/ingest.py",
      "app/main.py",
      "app/analysis/window.py",
      "pyproject.toml",
      "README.md"
    ],
    "typescript": [
      "src/otel/exporter.ts",
      "src/otel/index.ts",
      "src/config.ts",
      "src/instrumentation.ts",
      "package.json",
      "README.md"
    ]
  },
  "models": [
    "claude-opus-4-8",
    "claude-sonnet-4-6"
  ],
  "note": "Generated by scripts/blockgen/blockgen.py --emit-corpus. Do not hand-edit: test_blockgen.py asserts this matches the module.",
  "primary_marker": {
    "go": "go.mod",
    "python": "pyproject.toml",
    "typescript": "package.json"
  },
  "prompt_templates": [
    "Can you {verb} {obj}? {cond_clause}",
    "{obj_cap} is failing when {cond}, please {verb} it.",
    "I need help to {verb} {obj} before the release.",
    "Let's {verb} {obj} \u2014 {cond} and it's been bugging me.",
    "Take a look at {obj}. {cond_clause}",
    "{verb_cap} {obj}, then run the tests."
  ],
  "response_templates": [
    "I'll {verb} {obj} now.",
    "Looking at {obj}, the issue is {cond}. Let me {verb} it.",
    "Done \u2014 {obj} now handles the case where {cond}.",
    "On it. {obj_cap} needed a small change to {verb} the path where {cond}.",
    "Checked {obj}: {cond} was the root cause. Applying a fix."
  ],
  "tokens_per_active_minute": [
    50000,
    80000
  ],
  "turns_per_prompt": [
    2,
    4
  ]
}
