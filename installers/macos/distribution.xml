<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Keld</title>
  <!-- hostArchitectures MUST be set: a distribution pkg that omits it defaults to x86_64, so
       Installer.app demands Rosetta on Apple Silicon even though every payload binary is arm64.
       We ship mac arm64-only (macos-14 build); use arm64,x86_64 if a universal pkg is ever made. -->
  <options customize="never" require-scripts="true" hostArchitectures="arm64"/>
  <readme file="SECURITY-OVERVIEW.txt"/>
  <license file="EULA.txt"/>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default">
    <pkg-ref id="co.keld.agent"/>
    <pkg-ref id="co.keld.signal"/>
  </choice>
  <pkg-ref id="co.keld.agent" version="0">component.pkg</pkg-ref>
  <!-- Keld Signal.app (app/src-tauri), installing to /Applications — see build-pkg.sh
       for why it is a separate component (a different install location than the CLI
       payload's /usr/local/keld). customize="never" above keeps both installing as one
       unit; there is no way for someone running this pkg to get one without the other. -->
  <pkg-ref id="co.keld.signal" version="0">app-component.pkg</pkg-ref>
</installer-gui-script>
