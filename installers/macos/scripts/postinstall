#!/bin/bash
set -e
# Payload staged to /usr/local/keld; symlink the CLIs onto PATH and keep
# onboard.command beside keld-agent. The ML sidecar is NOT in this payload (Apple
# notarization scans every one of its ~15k files); onboard.command fetches it into
# ~/.local/bin, which sidecarBinPath() already searches.
PREFIX="/usr/local/keld"
# /usr/local/bin isn't guaranteed to exist — on an Apple-Silicon Mac with no
# Homebrew in /usr/local (Homebrew lives in /opt/homebrew), it's often absent.
# Under `set -e` a failing `ln` into a missing dir aborts the whole postinstall
# and fails the install, so ensure the target dir exists first.
mkdir -p /usr/local/bin
ln -sf "$PREFIX/keld" /usr/local/bin/keld
ln -sf "$PREFIX/keld-agent" /usr/local/bin/keld-agent

uid=$(stat -f %u /dev/console)
user=$(id -un "$uid")

# Idempotent install: repoint any stray keld/keld-agent in OTHER known PATH
# locations to this canonical install, so an older copy (e.g. a prior curl|sh
# install in ~/.local/bin) can't shadow it for the CLI or the tool hooks. We only
# touch files that already exist (never create new ones), and only when they
# aren't already the canonical symlink. Best-effort under `set -e`.
userhome=$(dscl . -read /Users/"$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
for d in ${userhome:+"$userhome/.local/bin"} /opt/homebrew/bin; do
  for b in keld keld-agent; do
    t="$d/$b"
    canon="$PREFIX/$b"
    if { [ -e "$t" ] || [ -L "$t" ]; } && [ "$(readlink "$t" 2>/dev/null)" != "$canon" ]; then
      sudo -u "$user" ln -sf "$canon" "$t" 2>/dev/null || true
    fi
  done
done

# ── Finish what the wizard pane started ──────────────────────────────────────
# The pane (installers/macos/plugin) ran BEFORE this, redeemed the setup code and
# staged the analysis sidecar; it left a handoff file naming what it did. This
# script does everything that rewrites the user's files, which deliberately does
# NOT happen in the pane: until the install is committed, a person can still
# cancel, and a cancelled install must not leave rewritten tool configs behind.
#
# ⚠️ EVERY user-side command runs `launchctl asuser <uid> sudo -u <user> -H`.
# Without -H, sudo keeps HOME=/var/root, and service_darwin.go builds the
# LaunchAgent path from os.UserHomeDir() — so the job would be written into
# root's home and never load, with nothing reporting it.
asuser() { launchctl asuser "$uid" sudo -u "$user" -H "$@"; }

HANDOFF="$userhome/.keld/state/installer-handoff.json"
paired=false
api_url=""
tools=""
staged=""
had_handoff=false
if [ -f "$HANDOFF" ]; then
  # ⚠️ A handoff can be LEFT BEHIND by a CANCELLED install: the pane writes it
  # in shouldExitPane, before the commit point, and this script only deletes it
  # on a run that reaches the bottom of this file. So a LATER install —
  # including one whose plugin fails to load silently, which is precisely the
  # case the fallback below exists for — can find a stale file from a
  # different build. Trust it only when its own `version` matches THIS build's
  # $PREFIX/VERSION; otherwise treat it as absent, so a stale "paired: false"
  # (or a stale tool list) from a cancelled install can never disable the
  # mandatory fallback or misconfigure this one.
  hv=$(/usr/bin/plutil -extract version raw -o - "$HANDOFF" 2>/dev/null || echo "")
  pv=""
  [ -f "$PREFIX/VERSION" ] && pv=$(tr -d ' \n' < "$PREFIX/VERSION")
  if [ "$hv" != "$pv" ]; then
    rm -f "$HANDOFF" || true
  else
    had_handoff=true
    paired=$(/usr/bin/plutil -extract paired raw -o - "$HANDOFF" 2>/dev/null || echo false)
    api_url=$(/usr/bin/plutil -extract api_url raw -o - "$HANDOFF" 2>/dev/null || echo "")
    staged=$(/usr/bin/plutil -extract sidecar_staged raw -o - "$HANDOFF" 2>/dev/null || echo "")
    tools=$(/usr/bin/plutil -extract tools json -o - "$HANDOFF" 2>/dev/null \
            | tr -d '[]"' | tr ',' ' ' || echo "")
  fi
fi

# 1. The analysis sidecar the pane already downloaded and verified: a rename into
#    place, in the user's own ~/.local/bin (same filesystem, so ~15,000 files move
#    atomically rather than being copied).
if [ -n "$staged" ] && [ -d "$staged" ]; then
  asuser "$PREFIX/keld" signal install-sidecar --commit "$staged" || true
else
  # No staged tree — no network in the pane, the pane never ran, or a person
  # clicked Continue before a slow download finished. Retry in the background:
  # enrichment spools until it lands, so this is late, not fatal.
  #
  # A Continue click mid-download can leave the pane's own spawned `keld` still
  # writing into a `.keld-update.*` staging dir under ~/.local/bin
  # (update.StageDir) — nothing ever commits or cleans it, and it would sit
  # there concurrently with the fresh fetch started below. Sweep it first, as
  # the user, best-effort.
  asuser /bin/sh -c "rm -rf \"$userhome\"/.local/bin/.keld-update.* 2>/dev/null" || true

  # ⚠️ PINNED to this pkg's own release, the same way onboard.command's
  # fetch_sidecar already does. An unpinned call resolves releases/latest,
  # which lags behind an in-flight pre-release train (see CHANGELOG.md) and
  # would install a STALE sidecar under this daemon — the exact version-skew
  # failure AGENTS.md documents at length (a 2.3.0 daemon against an Aug-11
  # sidecar: /blocks 404s, zero blocks published, doctor reports no problems).
  tag=""
  [ -f "$PREFIX/VERSION" ] && tag=$(tr -d ' \n' < "$PREFIX/VERSION")
  case "$tag" in ""|*dryrun*) tag="" ;; esac

  # ⚠️ THIS FALLBACK RAN AND ACHIEVED NOTHING, SILENTLY, ON EVERY FAST INSTALL.
  # It used to be `asuser /bin/sh -c "keld signal install-sidecar … &"` with the
  # output sent to /dev/null. Measured on a real v3.0.2 install (2026-09-16):
  # postinstall ran at 10:40:34, the fallback fired, and two minutes later there
  # was no fetch process, no staging directory, and a sidecar tree still bearing
  # its previous timestamp. Running the SAME command by hand worked first time,
  # so the fetch is fine — what does not survive is a bare background child of a
  # script PackageKit tears down the moment it exits.
  #
  # Who hits it: anyone ALREADY SIGNED IN. They reach Continue in seconds, the
  # pane's ~190MB download has not finished, so no tree is staged and this is the
  # only path left. The faster the person, the likelier their sidecar never
  # updates — and nothing said so, because of the /dev/null.
  #
  # Two changes. The work is handed to LAUNCHD, which owns it independently of
  # this script's lifetime; and it writes a LOG, so the next occurrence is one
  # file rather than an investigation. The plist removes itself after running,
  # so nothing persists once the fetch is done.
  fetch_log="$userhome/.keld/logs/sidecar-install.log"
  asuser /bin/sh -c "mkdir -p \"$userhome/.keld/logs\"" || true
  plist="$userhome/Library/LaunchAgents/co.keld.sidecar-fetch.plist"

  # ⚠️ THE JOB RUNS THE SIGNED BINARY, NOT A GENERATED SHELL SCRIPT — because
  # macOS NAMES THE BACKGROUND ITEM AFTER THE PROGRAM AND SHOWS IT TO THE PERSON
  # INSTALLING. The first version ran ~/.keld/logs/.sidecar-fetch.sh, and macOS
  # announced "'.sidecar-fetch.sh' can run in the background": a dot-prefixed
  # script inside a log directory, presented to someone who just wanted to
  # install Keld (reported from a real install, 2026-09-16). Running
  # `$PREFIX/keld` directly means macOS names Keld's own signed binary instead.
  #
  # Everything the wrapper existed for is now native: launchd writes the log
  # through StandardOutPath/StandardErrorPath, and `--cleanup-job` has the
  # binary delete this plist after a SUCCESSFUL install (unit-tested in
  # installsidecar_test.go). On failure the plist stays, because it is the only
  # thing that will try again.
  args="<string>$PREFIX/keld</string><string>signal</string><string>install-sidecar</string>"
  if [ -n "$tag" ]; then
    args="$args<string>--tag</string><string>$tag</string>"
  fi
  args="$args<string>--cleanup-job</string><string>$plist</string>"

  cat > "$plist" <<PLIST 2>/dev/null || true
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>co.keld.sidecar-fetch</string>
  <key>ProgramArguments</key><array>$args</array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$fetch_log</string>
  <key>StandardErrorPath</key><string>$fetch_log</string>
</dict></plist>
PLIST
  chown "$user" "$plist" 2>/dev/null || true
  asuser /bin/launchctl bootout "gui/$uid/co.keld.sidecar-fetch" 2>/dev/null || true
  if asuser /bin/launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null; then
    echo "  • analysis sidecar downloading in the background — see ~/.keld/logs/sidecar-install.log"
  else
    # launchd refused the job. Say so rather than leaving the machine to find
    # out via a version-skew finding days later.
    rm -f "$plist" 2>/dev/null || true
    echo "  ⚠ could not start the sidecar download. Run: keld signal install-sidecar"
  fi
fi

# 2. The AI tools the person ticked. --bin-path pins the INSTALLED keld: the pane
#    ran a copy from inside the plugin bundle, and pinning THAT path into hook
#    commands breaks every hook the moment the wizard closes.
#
# ⚠️ AN EMPTY SELECTION MUST CONFIGURE NOTHING, not everything.
# `tools.Select(nil)` reads "no --tool flags at all" as "configure every
# detected adapter" — correct when the pane never ran (had_handoff is false,
# so today's unfiltered `signal setup` behaviour is exactly right), and wrong
# when the pane DID run and every checkbox was unticked (had_handoff is true
# and tools is empty): that person made a choice, and without had_handoff the
# two cases are indistinguishable.
if [ "$paired" = "true" ] || [ "$paired" = "1" ]; then
  if [ "$had_handoff" = true ] && [ -z "$tools" ]; then
    : # every tool was unticked; configure none
  else
    set -- signal setup --yes --bin-path "$PREFIX/keld"
    [ -n "$api_url" ] && set -- "$@" --api-url "$api_url"
    for t in $tools; do
      [ -n "$t" ] && set -- "$@" --tool "$t"
    done
    asuser "$PREFIX/keld" "$@" || true
  fi
fi

# 3. Register and start the agent. This is what used to happen only inside the
#    Terminal script, which is why a machine that never opened it collected
#    nothing.
asuser "$PREFIX"/keld-agent install || true

rm -f "$HANDOFF" || true

# ⚠️ FALLBACK — and it is not optional, but it is deliberately NARROW. The
# wizard plugin can fail to load with NO diagnostic whatsoever (a stale code
# signature does exactly this; measured 2026-09-14): the pane never ran, the
# handoff file was never written, and a machine in that state has installed
# cleanly and been asked for nothing — so without this it would sit idle
# forever. That is the ONLY case this is for. Gating on hook.json alone would
# also fire for someone who ran the pane and deliberately clicked "Set up
# later": that person made a choice, and opening a Terminal at them is exactly
# what this branch exists to stop. So both halves are required: the pane never
# ran (had_handoff is false, captured above before the handoff file was
# deleted) AND the machine ended up unconfigured (no hook.json).
if [ "$had_handoff" = false ] && [ ! -f "$userhome/.keld/hook.json" ] && [ -f "$PREFIX/onboard.command" ]; then
  chmod +x "$PREFIX/onboard.command" || true
  launchctl asuser "$uid" sudo -u "$user" open "$PREFIX/onboard.command" || true
fi

exit 0
